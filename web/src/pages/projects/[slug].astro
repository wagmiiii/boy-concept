---
// Project page (P-7, FR-4). Every entry here is 9:16, so the player is a portrait frame and the
// page is built around it rather than around a wide hero. Playback stays poster first: the clip is
// only fetched when the visitor taps (ESSENTIALS rule 10).
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { sampleFootageLabel, visibleProjects } from "../../content-rules";
import { posterFor } from "../../poster-index";
import { isSelfHostedVideo, youtubeEmbedUrl } from "../../media-sources";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const visible = visibleProjects(projects);
  return visible.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const data = project.data;
const posterImage = data.poster ? posterFor(data.poster) : undefined;
const youtubeUrl = data.video_url ? youtubeEmbedUrl(data.video_url) : undefined;
const isSelfHosted = data.video_url ? isSelfHostedVideo(data.video_url) : false;
const playable = isSelfHosted || Boolean(youtubeUrl);
const facts = [
  data.client_name ? ["Client", data.client_name] : null,
  data.event_name ? ["Event", data.event_name] : null,
  data.location ? ["Location", data.location] : null,
  data.year ? ["Year", String(data.year)] : null,
].filter((fact): fact is [string, string] => fact !== null);
---

<Base
  title={`${data.title} | Boy Concept`}
  description={data.summary || `${data.title}, a ${data.category.toLowerCase()} film by Boy Concept (Alpha Movies Ltd)`}
>
  <Nav />

  <main class="relative overflow-hidden pb-20 pt-32 md:pb-32 md:pt-40">
    <div class="ambient-gold pointer-events-none absolute inset-x-0 top-0 h-[480px]" aria-hidden="true"></div>

    <div class="container-site relative">
      <nav aria-label="Breadcrumb">
        <a href="/#work" class="inline-flex min-h-11 items-center gap-2 text-small text-text-muted transition-colors hover:text-gold">
          <svg class="size-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M11 6l-6 6 6 6" />
          </svg>
          All work
        </a>
      </nav>

      <header class="mt-6 flex flex-col gap-4" data-reveal>
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip" data-active="true">{data.category}</span>
          {data.demo ? <span class="tag">{sampleFootageLabel}</span> : null}
        </div>
        <h1 class="max-w-[18ch] text-display font-semibold text-text">{data.title}</h1>
      </header>

      <div class="mt-10 grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-16">
        <div class="mx-auto w-full max-w-[420px] lg:mx-0" data-reveal data-reveal-delay="1">
          <div
            id="project-player-frame"
            class="tile-frame aspect-[9/16] border border-line-strong bg-surface-2 shadow-[0_50px_120px_-50px_var(--bg)]"
            data-src={data.video_url}
            data-kind={isSelfHosted ? "file" : youtubeUrl ? "youtube" : "none"}
            aria-label={`Play ${data.title}`}
          >
            {
              posterImage ? (
                <Image
                  src={posterImage}
                  widths={[420, 720]}
                  sizes="(max-width: 1023px) 92vw, 420px"
                  alt={`${data.title} still`}
                  class="absolute inset-0 size-full object-cover"
                />
              ) : (
                <span class="absolute inset-0 flex items-center justify-center text-small uppercase tracking-[0.14em] text-text-muted">
                  Still to come
                </span>
              )
            }

            {
              playable ? (
                <button
                  type="button"
                  id="project-play-btn"
                  class="absolute inset-0 z-20 flex items-center justify-center"
                  aria-label={`Play ${data.title}`}
                >
                  <span class="flex size-16 items-center justify-center rounded-full border border-media-text/40 bg-bg/40 text-media-text backdrop-blur-md transition-all duration-300 hover:scale-105 hover:border-gold hover:bg-gold hover:text-bg">
                    <svg class="ml-1 size-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M8 5.5v13l11-6.5z" />
                    </svg>
                  </span>
                </button>
              ) : null
            }
          </div>
          {
            data.demo ? (
              <p class="mt-3 text-center text-small text-text-muted lg:text-left">
                {sampleFootageLabel}. Not a client case study.
              </p>
            ) : null
          }
        </div>

        <div class="flex flex-col gap-10">
          <section class="flex flex-col gap-4" data-reveal data-reveal-delay="2">
            <p class="eyebrow">The brief</p>
            <p class="text-body-large text-text-2">{data.summary}</p>
          </section>

          {
            facts.length > 0 && (
              <section class="flex flex-col gap-4 border-t border-line pt-8">
                <p class="eyebrow">Details</p>
                <dl class="grid grid-cols-2 gap-x-6 gap-y-5">
                  {facts.map(([label, value]) => (
                    <div class="flex flex-col gap-1">
                      <dt class="text-eyebrow uppercase tracking-[0.18em] text-text-muted">{label}</dt>
                      <dd class="text-small text-text">{value}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )
          }

          {
            data.deliverables.length > 0 && (
              <section class="flex flex-col gap-3 border-t border-line pt-8">
                <p class="eyebrow">Delivered</p>
                <ul class="flex flex-wrap gap-2">
                  {data.deliverables.map((item) => (
                    <li class="tag">{item}</li>
                  ))}
                </ul>
              </section>
            )
          }

          <section class="flex flex-col gap-4 rounded-panel border border-line bg-surface-1 p-6 md:p-8">
            <h2 class="text-h4 font-semibold text-text">Film something like this</h2>
            <p class="max-w-[42ch] text-small text-text-2">
              Send the date and the brief. We answer with availability first, then the shape of the
              shoot.
            </p>
            <a href="/commission/" class="btn-primary w-full md:w-auto md:self-start">
              Check a date
              <svg class="size-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </section>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    import { youtubeEmbedUrl } from "../../media-sources";

    const frame = document.getElementById("project-player-frame") as HTMLElement | null;
    const playBtn = document.getElementById("project-play-btn") as HTMLButtonElement | null;

    const startPlayback = () => {
      if (!frame) return;
      const kind = frame.dataset.kind;
      const src = frame.dataset.src;
      if (!src || kind === "none") return;

      if (kind === "youtube") {
        const embed = youtubeEmbedUrl(src);
        if (!embed) return;
        const iframe = document.createElement("iframe");
        iframe.src = embed;
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
        iframe.allowFullscreen = true;
        iframe.className = "absolute inset-0 z-10 size-full border-0";
        iframe.title = frame.getAttribute("aria-label") || "Project video";
        frame.innerHTML = "";
        frame.appendChild(iframe);
      } else if (kind === "file") {
        const video = document.createElement("video");
        video.src = src;
        video.controls = true;
        video.playsInline = true;
        video.autoplay = true;
        video.className = "absolute inset-0 z-10 size-full bg-surface-cinema object-cover";
        frame.innerHTML = "";
        frame.appendChild(video);
      }
    };

    playBtn?.addEventListener("click", (event) => {
      event.stopPropagation();
      startPlayback();
    });
  </script>
</Base>
