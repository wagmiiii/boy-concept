---
// Scaffold page. P-2 replaces it with the real section order; it exists to prove the tokens,
// the fonts and the logo asset path work end to end.
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import logo from "../assets/brand/alpha-movies-logo.webp";
---

<Base title="Alpha Movies scaffold" description="Workspace scaffold check">
  <main class="mx-auto flex max-w-site flex-col gap-6 px-5 py-18 md:px-8 md:py-30">
    <Image src={logo} alt="Alpha Movies" width={800} class="max-w-full" />
    <p class="text-eyebrow font-semibold uppercase tracking-[0.18em] text-gold">Scaffold</p>
    <h1 class="text-display font-display">Marcellus on black</h1>
    <p class="text-body-large text-text-2">
      Type scale, gold ramp and the logo path are wired from DESIGN.md. The sections arrive at P-2.
    </p>
  </main>
</Base>
