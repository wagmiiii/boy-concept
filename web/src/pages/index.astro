---
// P-2: the section order from docs/PRD.md section 5.
// Direct commission CTA section links to dedicated /commission/ booking brief page.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Showreel from "../components/Showreel.astro";
import PortfolioGrid from "../components/PortfolioGrid.astro";
import Credentials from "../components/Credentials.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../../../shared/site-config";
import { buildWhatsAppDirectLink } from "../../../shared/whatsapp";

const directWhatsAppUrl = buildWhatsAppDirectLink(siteConfig.ownerWhatsAppDigits);
---

<Base title="Boy Concept">
  <Nav />

  <main>
    <Hero />
    <Showreel />
    <PortfolioGrid />
    <Credentials />
    <Services />
    <Process />
    <Faq />

    {/* Direct Commission Call to Action Section */}
    <section id="enquiry" class="relative bg-surface-1 py-18 md:py-30 overflow-hidden">
      <div class="pointer-events-none absolute inset-0 glow-gold-ambient opacity-50" aria-hidden="true"></div>
      <div class="container-site relative flex flex-col gap-8">
        <div class="flex flex-col gap-3" data-reveal>
          <p class="eyebrow">Direct Commission</p>
          <h2 class="font-display text-h2 text-text">Ready to Commission Your Production?</h2>
          <p class="max-w-[65ch] text-body-large text-text-2">
            Commercial campaigns, luxury weddings, cultural celebrations, and documentary retrospectives. Reserve your date and receive a bespoke production proposal.
          </p>
        </div>

        <div class="card p-8 md:p-12 flex flex-col gap-8 md:flex-row md:items-center md:justify-between" data-reveal data-reveal-delay="1">
          <div class="flex flex-col gap-3 max-w-xl">
            <div class="cinematic-badge self-start">
              <span>CALENDAR OPEN • 2026/27</span>
            </div>
            <h3 class="font-display text-h3 text-text">Reserve Your Event Date</h3>
            <p class="text-body text-text-2 leading-relaxed">
              We review every brief directly and reply with bespoke creative treatment, camera crew allocation, and confirmed pricing. Zero commitment to inquire.
            </p>
            <p class="text-small text-text-muted pt-1">
              Packages start from <span class="text-gold font-semibold">₦[amount]</span> &bull; Direct WhatsApp brief handoff
            </p>
          </div>

          <div class="flex flex-col gap-3 shrink-0 items-stretch md:items-center">
            <a href="/commission/" class="btn-primary shadow-glow-gold hover:scale-[1.02] transition-transform text-base group px-8 py-4">
              <span>Begin Commission Brief</span>
              <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </a>
            <a
              href={directWhatsAppUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-small text-center text-gold underline underline-offset-4 hover:text-gold-bright transition-colors pt-1"
            >
              Message directly on WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
