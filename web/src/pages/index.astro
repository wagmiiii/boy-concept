---
// P-2: the section order from docs/PRD.md section 5. Copy is bracketed until C-10 and every
// placeholder is registered in content/PLACEHOLDERS.md. The enquiry block is a shell: the Preact
// island replaces it at P-12.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Showreel from "../components/Showreel.astro";
import PortfolioGrid from "../components/PortfolioGrid.astro";
import Credentials from "../components/Credentials.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";

// The order is the PRD section 7 field list. Event date is first, and there is no budget field
// anywhere on the site (FR-11). The list carries no numbers: the order is the sequence, and 1 to 13
// would be decoration. The submit button is full width on mobile and md:self-start is what shrinks
// it at desktop, because a flex column stretches its items whatever width the item asks for.
const fields = [
  "Event date",
  "Second date or end date",
  "Project type",
  "Venue, city, country",
  "Duration",
  "Deliverables",
  "Reference video",
  "Name",
  "Company or agency",
  "WhatsApp number",
  "Email",
  "Notes",
  "Consent",
];
---

<Base title="Boy Concept">
  <Nav />

  <main>
    <Hero />
    <Showreel />
    <PortfolioGrid />
    <Credentials />
    <Services />
    <Process />
    <Faq />

    <section id="enquiry" class="bg-surface-1">
      <div class="container-site flex flex-col gap-6 py-18 md:py-30">
        <div class="flex flex-col gap-2">
          <p class="eyebrow">Check a date</p>
          <h2 class="font-display text-h2">[Enquiry heading, written at C-10]</h2>
        </div>

        <div class="card flex flex-col gap-3 p-6">
          <p class="text-body text-text-2">
            Packages start from <span class="font-semibold text-gold">₦[amount]</span>
          </p>

          <ul class="flex flex-col gap-1 text-body text-text-2">
            {fields.map((field) => <li>{field}</li>)}
          </ul>

          <p class="text-small text-text-muted">
            The fields are a list, not a working form yet. The island arrives at P-12 with
            validation, the confirmation screen and the WhatsApp handoff.
          </p>

          <button type="button" class="btn-primary w-full md:w-auto md:self-start" disabled>
            Send brief
          </button>

          <p class="text-body text-text-2">[Response-time line, FR-15: only a time someone keeps]</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
