---
// DESIGN.md section 7 Category filter and Portfolio card.
// P-6: Interactive category filtering, poster rendering, and empty category pruning (FR-3, FR-26).
import { getCollection } from "astro:content";
import { projectCategories, visibleProjects } from "../content-rules";
import ProjectCard from "./ProjectCard.astro";

const cards = visibleProjects(await getCollection("projects"));

// FR-26: Only show chips for categories that have at least one visible project.
const activeCategories = projectCategories.filter((category) =>
  cards.some((project) => project.data.category === category)
);
---

<section
  id="work"
  class="container-site flex flex-col gap-6 py-18 md:py-30"
>
  <div class="flex flex-col gap-2">
    <p class="eyebrow">Work</p>
    <h2 class="font-display text-h2">[Portfolio heading, written at C-10]</h2>
  </div>

  <div class="flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Filter by category" id="portfolio-filters">
    <button type="button" class="chip shrink-0 cursor-pointer" data-filter="all" data-active="true" aria-pressed="true">
      All
    </button>
    {
      activeCategories.map((category) => (
        <button type="button" class="chip shrink-0 cursor-pointer" data-filter={category} aria-pressed="false">
          {category}
        </button>
      ))
    }
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" id="portfolio-grid">
    {
      cards.map((project) => (
        <ProjectCard
          category={project.data.category}
          title={project.data.title}
          poster={project.data.poster}
          slug={project.id}
        />
      ))
    }
  </div>
</section>

<script>
  // P-6: Client-side category filtering. Emitted as external JS file under D26.
  const filterContainer = document.getElementById("portfolio-filters");
  const grid = document.getElementById("portfolio-grid");

  if (filterContainer && grid) {
    const buttons = filterContainer.querySelectorAll<HTMLButtonElement>("button[data-filter]");
    const articles = grid.querySelectorAll<HTMLElement>("article[data-category]");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter;
        if (!filter) return;

        buttons.forEach((b) => {
          const isActive = b === btn;
          b.dataset.active = isActive ? "true" : "false";
          b.setAttribute("aria-pressed", isActive ? "true" : "false");
        });

        articles.forEach((card) => {
          const cardCat = card.dataset.category;
          const match = filter === "all" || cardCat === filter;
          card.style.display = match ? "" : "none";
        });
      });
    });
  }
</script>
