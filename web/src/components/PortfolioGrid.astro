---
// DESIGN.md section 7 Category filter and Portfolio card. The projects come from the content
// collection (P-5); the categories come from the same list the schema allows, so a chip can never
// name a category a project cannot be filed under.
// FR-26: a chip with no verified projects hides, which is what P-6 wires up.
import { getCollection } from "astro:content";
import { placeholderProjects, projectCategories, shorableProjects } from "../content-rules";
import ProjectCard from "./ProjectCard.astro";

const projects = await getCollection("projects");
// FR-3 and FR-27: only a verified, permitted project is shorable. While none is, the section keeps
// its shape with the entries the schema marks demo: true, and those can never carry a claim
// (D23). Real work that is merely unverified renders nothing at all.
const shorable = shorableProjects(projects);
const cards = shorable.length > 0 ? shorable : placeholderProjects(projects);
---

<section
  id="work"
  class="container-site flex flex-col gap-6 py-18 md:py-30"
>
  <div class="flex flex-col gap-2">
    <p class="eyebrow">Work</p>
    <h2 class="font-display text-h2">[Portfolio heading, written at C-10]</h2>
  </div>

  <div class="flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Filter by category">
    <button type="button" class="chip shrink-0" data-active="true" disabled>All</button>
    {
      projectCategories.map((category) => (
        <button type="button" class="chip shrink-0" disabled>
          {category}
        </button>
      ))
    }
  </div>

  <p class="text-small text-text-muted">
    The chips are disabled: filtering needs the verified projects, and that is task P-6.
  </p>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {cards.map((project) => <ProjectCard category={project.data.category} title={project.data.title} />)}
  </div>
</section>
