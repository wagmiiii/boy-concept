---
// FR-20, FR-24 and DESIGN.md section 7 Footer.
// Direct WhatsApp link built from shared/site-config.ts (P-10, P-15).
import { Image } from "astro:assets";
import logo from "../assets/brand/alpha-movies-logo.webp";
import { siteConfig } from "../../../shared/site-config";
import { buildWhatsAppDirectLink } from "../../../shared/whatsapp";

const year = new Date().getFullYear();
const directWhatsAppUrl = buildWhatsAppDirectLink(siteConfig.ownerWhatsAppDigits);

const links = [
  { label: "Instagram", value: "[handle]", href: undefined },
  { label: "YouTube", value: "[channel]", href: undefined },
  { label: "WhatsApp", value: siteConfig.ownerWhatsAppDigits, href: directWhatsAppUrl },
];
---

<footer class="border-t border-line bg-surface-1">
  <div class="container-site flex flex-col gap-8 py-18">
    <Image
      src={logo}
      widths={[440, 880]}
      sizes="(max-width: 767px) 350px, 440px"
      alt="Alpha Movies"
      class="w-full max-w-110"
    />

    <ul class="flex flex-col gap-2">
      {
        links.map((link) => (
          <li class="flex flex-wrap items-baseline gap-2 text-body">
            <span class="font-semibold text-text">{link.label}</span>
            {link.href ? (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gold underline hover:text-gold-bright"
                data-track-whatsapp={link.label === "WhatsApp" ? "true" : undefined}
              >
                {link.value}
              </a>
            ) : (
              <span class="text-text-muted">{link.value}</span>
            )}
          </li>
        ))
      }
    </ul>

    <p class="text-body text-text-2">Base city: [confirm, Q3]</p>

    <p class="text-small text-text-muted">
      Already booked with us?{" "}
      <a
        href={directWhatsAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-track-whatsapp="true"
        class="font-semibold text-gold underline underline-offset-4 hover:text-gold-bright"
      >
        Message directly on WhatsApp
      </a>. Works without JavaScript.
    </p>

    <div class="flex flex-wrap items-center justify-between gap-4 text-small text-text-muted">
      <p>© {year} Boy Concept (Alpha Movies Ltd). RC [confirm on CAC public search]</p>
      <a href="/privacy" class="hover:text-text-2 underline underline-offset-2">Privacy Notice</a>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-track-whatsapp]").forEach((el) => {
    el.addEventListener("click", () => {
      if (typeof window !== "undefined" && typeof (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag === "function") {
        (window as unknown as { gtag: (...args: unknown[]) => void }).gtag("event", "whatsapp_tap", { source: "footer" });
      }
    });
  });
</script>
