---
// FR-20, FR-24 and DESIGN.md section 7 Footer.
// Direct WhatsApp link built from shared/site-config.ts (P-10, P-15).
import { Image } from "astro:assets";
import logo from "../assets/brand/alpha-movies-logo.webp";
import { siteConfig } from "../../../shared/site-config";
import { buildWhatsAppDirectLink } from "../../../shared/whatsapp";

const year = new Date().getFullYear();
const directWhatsAppUrl = buildWhatsAppDirectLink(siteConfig.ownerWhatsAppDigits);

const links = [
  { label: "Instagram", value: "[handle]", href: undefined },
  { label: "YouTube", value: "[channel]", href: undefined },
  { label: "WhatsApp", value: siteConfig.ownerWhatsAppDigits, href: directWhatsAppUrl },
];
---

<footer class="border-t border-line bg-surface-1">
  <div class="container-site flex flex-col gap-12 py-18 md:py-24">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 md:items-start md:justify-between">
      <div class="flex flex-col gap-4" data-reveal>
        <Image
          src={logo}
          widths={[440, 880]}
          sizes="(max-width: 767px) 300px, 380px"
          alt="Alpha Movies Ltd"
          class="w-full max-w-95 brightness-95"
        />
        <p class="max-w-[42ch] text-small text-text-muted">
          Master-grade cinematography, high-framerate multi-cam coverage, and bespoke post-production for milestone occasions worldwide.
        </p>
      </div>

      <div class="flex flex-col gap-6 md:items-end" data-reveal data-reveal-delay="1">
        <ul class="flex flex-col gap-3 md:items-end">
          {
            links.map((link) => (
              <li class="flex flex-wrap items-baseline gap-2 text-body">
                <span class="text-small font-semibold tracking-wider uppercase text-text-muted">{link.label}:</span>
                {link.href ? (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-gold underline underline-offset-4 hover:text-gold-bright transition-colors"
                    data-track-whatsapp={link.label === "WhatsApp" ? "true" : undefined}
                  >
                    {link.value}
                  </a>
                ) : (
                  <span class="text-text-muted">{link.value}</span>
                )}
              </li>
            ))
          }
        </ul>

        <div class="flex flex-col gap-1 md:text-right">
          <p class="text-body text-text-2">Studio base: <span class="text-text">[confirm, Q3]</span></p>
          <p class="text-small text-text-muted">
            Existing clients:{" "}
            <a
              href={directWhatsAppUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track-whatsapp="true"
              class="font-semibold text-gold underline underline-offset-4 hover:text-gold-bright"
            >
              Direct WhatsApp channel
            </a>
          </p>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line/60 pt-6 text-small text-text-muted" data-reveal data-reveal-delay="2">
      <p>© {year} Boy Concept (Alpha Movies Ltd). RC [confirm on CAC public search]</p>
      <a href="/privacy" class="hover:text-text-2 underline underline-offset-4 transition-colors">Privacy Notice</a>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-track-whatsapp]").forEach((el) => {
    el.addEventListener("click", () => {
      if (typeof window !== "undefined" && typeof (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag === "function") {
        (window as unknown as { gtag: (...args: unknown[]) => void }).gtag("event", "whatsapp_tap", { source: "footer" });
      }
    });
  });
</script>
