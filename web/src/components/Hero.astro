---
// Hero. The headline is a builder draft under D25, registered in content/PLACEHOLDERS.md, and it
// makes no factual claim. The media card is poster first: the clip is created inside the tap, so
// nothing points at a video byte until the visitor asks (ESSENTIALS rule 10).
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { sampleFootageLabel, visibleProjects } from "../content-rules";
import { posterFor } from "../poster-index";
import logo from "../assets/brand/alpha-movies-logo.webp";

const projects = visibleProjects(await getCollection("projects"));
const portraitProject =
  projects.find((project) => project.data.poster?.includes("poster-09")) ?? projects[0];
const wideProject =
  projects.find((project) => project.data.poster?.includes("poster-04")) ?? projects[1];

const portraitPoster = portraitProject?.data.poster ? posterFor(portraitProject.data.poster) : undefined;
const widePoster = wideProject?.data.poster ? posterFor(wideProject.data.poster) : undefined;

const marquee = ["Weddings", "Cultural events", "Commercial", "Documentary", "Music films", "Same-day edits"];
---

<section id="top" class="relative overflow-hidden pb-14 pt-32 md:pb-20 md:pt-40">
  <div class="ambient-gold pointer-events-none absolute inset-x-0 -top-40 h-[560px]" aria-hidden="true"></div>

  <div class="container-site relative">
    <div class="grid items-end gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div class="flex flex-col items-start">
        <p class="eyebrow" data-reveal>
          Alpha Movies presents
        </p>

        <h1
          class="mt-6 text-display font-semibold text-text"
          data-reveal
          data-reveal-delay="1"
        >
          Films with<br />
          <span class="display-italic text-gold">feeling.</span>
        </h1>

        <p
          class="mt-7 max-w-[46ch] text-body-large text-text-2"
          data-reveal
          data-reveal-delay="2"
        >
          Weddings, cultural events, campaigns and documentaries, shot with a cinema eye in Lagos and
          wherever the story is. Tell us the date and we will tell you what is possible.
        </p>

        <div class="mt-9 flex w-full flex-col gap-3 md:w-auto md:flex-row md:items-center" data-reveal data-reveal-delay="3">
          <a href="/commission/" class="btn-primary">
            Check a date
            <svg class="size-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <a href="#reel" class="btn-secondary">
            <svg class="size-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5.5v13l11-6.5z" />
            </svg>
            Watch the reel
          </a>
        </div>

        <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-line pt-7" data-reveal data-reveal-delay="4">
          <Image
            src={logo}
            widths={[280, 560]}
            sizes="220px"
            alt="Alpha Movies"
            loading="eager"
            fetchpriority="high"
            class="logo-plate h-auto w-[200px] opacity-90 md:w-[240px]"
          />
          <p class="max-w-[22ch] text-small text-text-muted">
            The film and video studio behind Boy Concept.
          </p>
        </div>
      </div>

      {/* Media composition: two vertical frames, the smaller one offset behind. Every clip on the
          site is 9:16 now, so the composition stays portrait instead of letterboxing the footage. */}
      <div class="relative mx-auto w-full max-w-[480px] lg:max-w-none" data-reveal data-reveal-delay="2">
        {
          wideProject && widePoster ? (
            <div class="absolute -top-8 -right-2 hidden w-[52%] rotate-2 md:block" aria-hidden="true">
              <div class="tile-frame aspect-[9/16] border border-line shadow-2xl">
                <Image
                  src={widePoster}
                  widths={[420, 840]}
                  sizes="(max-width: 1199px) 320px, 380px"
                  alt=""
                  class="absolute inset-0 size-full object-cover"
                />
              </div>
            </div>
          ) : null
        }

        <div class="relative ml-auto w-[78%] max-w-[360px] pt-12 md:pt-20">
          <div
            class="tile-frame aspect-[9/16] border border-line-strong shadow-[0_40px_90px_-30px_var(--bg)]"
            data-feature
            data-src={portraitProject?.data.video_url ?? ""}
            data-kind="file"
          >
            {
              portraitPoster ? (
                <Image
                  src={portraitPoster}
                  widths={[420, 840]}
                  sizes="(max-width: 767px) 78vw, 360px"
                  alt={portraitProject ? `${portraitProject.data.title} still` : "Film still"}
                  loading="eager"
                  class="absolute inset-0 size-full object-cover"
                />
              ) : null
            }

            <div class="media-chrome absolute inset-0 flex flex-col justify-between p-4">
              <div class="flex items-center justify-between">
                <span class="tag">Now screening</span>
                <span class="font-mono text-[0.7rem] tracking-[0.18em] text-media-text/80">
                  {portraitProject?.data.category ?? ""}
                </span>
              </div>

              <div class="flex items-end justify-between gap-3">
                <div>
                  <p class="text-small font-medium text-media-text">
                    {portraitProject?.data.title ?? "Selected work"}
                  </p>
                  <p class="text-eyebrow uppercase tracking-[0.18em] text-media-text/65">{sampleFootageLabel}</p>
                </div>

                <button type="button" class="btn-icon border-media-text/30 text-media-text" data-feature-play>
                  <span class="sr-only">Play the featured clip</span>
                  <svg class="ml-0.5 size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 5.5v13l11-6.5z" />
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="glass absolute -left-6 bottom-8 hidden items-center gap-3 rounded-full px-4 py-3 md:flex">
            <span class="flex size-2 items-center justify-center">
              <span class="size-2 rounded-full bg-gold"></span>
            </span>
            <span class="text-small text-text-2">Reel 2026</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="marquee mt-16 border-y border-line py-4 md:mt-24">
    <div class="marquee-track" aria-hidden="true">
      {
        [...marquee, ...marquee].map((item) => (
          <span class="flex items-center gap-6 pr-6 text-small font-medium uppercase tracking-[0.24em] text-text-muted">
            {item}
            <svg class="size-2.5 fill-gold" viewBox="0 0 24 24">
              <path d="M12 0L14.8 9.2L24 12L14.8 14.8L12 24L9.2 14.8L0 12L9.2 9.2L12 0Z" />
            </svg>
          </span>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Poster first. The video element exists only after the visitor presses play.
  const feature = document.querySelector<HTMLElement>("[data-feature]");
  const playButton = feature?.querySelector<HTMLButtonElement>("[data-feature-play]");

  playButton?.addEventListener("click", () => {
    if (!feature) return;
    const src = feature.dataset.src ?? "";
    if (!src) return;

    const video = document.createElement("video");
    video.src = src;
    video.controls = true;
    video.autoplay = true;
    video.playsInline = true;
    video.className = "absolute inset-0 z-0 size-full bg-surface-cinema object-cover";
    feature.append(video);
    feature.dataset.playing = "true";
    void video.play().catch(() => undefined);
  });
</script>
