---
// DESIGN.md section 7 Hero, and FR-1: brand statement, primary CTA that scrolls to the form,
// secondary CTA to the showreel. The headline is one of three drafts the builder wrote, listed in
// content/copy.md, and none of them is approved. It stays an open placeholder in
// content/PLACEHOLDERS.md until Q1 and C-10, and it makes no claim a verification-log row would
// have to back: no superlative, no stat, no client name.
import { Image } from "astro:assets";
import logo from "../assets/brand/alpha-movies-logo.webp";

// DESIGN.md section 8: at most three flares in view, decorative only, static on mobile.
const sparkles = ["sparkle-a size-4 -left-2 top-1", "sparkle-b size-3 -right-3 top-8", "sparkle-c size-3 -bottom-1 left-[18%]"];
---

<section
  id="hero"
  class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-32"
>
  {/* Atmospheric ambient lighting glow */}
  <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-[min(900px,96vw)] h-[500px] glow-gold-ambient blur-3xl opacity-80" aria-hidden="true" />

  <div class="container-site relative z-10 flex flex-col items-center gap-7 text-center">
    {/* Brand Logo & Sparkles */}
    <div class="relative w-full max-w-140 my-2 animate-reveal">
      <Image
        src={logo}
        widths={[560, 1120]}
        sizes="(max-width: 767px) 340px, 560px"
        alt="Alpha Movies"
        loading="eager"
        fetchpriority="high"
        class="w-full drop-shadow-[0_12px_24px_rgba(0,0,0,0.8)]"
      />

      {
        sparkles.map((cls) => (
          <svg
            class={`pointer-events-none absolute ${cls}`}
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 0c1 6.5 5.5 11 12 12-6.5 1-11 5.5-12 12-1-6.5-5.5-11-12-12C6.5 11 11 6.5 12 0Z" />
          </svg>
        ))
      }
    </div>

    {/* Headline & Subheadline */}
    <div class="flex flex-col items-center gap-4 max-w-3xl animate-reveal delay-1">
      <h1 class="text-balance font-display text-display tracking-tight text-text">
        Shot for the <span class="bg-gradient-to-r from-gold-bright via-gold to-gold-deep bg-clip-text text-transparent">occasion</span>
      </h1>

      <p class="max-w-[55ch] text-body-large text-text-2 leading-relaxed">
        Commercial films, cultural festival coverage, wedding and documentary work. Tell us the date
        and we will tell you what is possible.
      </p>
    </div>

    {/* CTA Row */}
    <div class="flex flex-col gap-3.5 pt-2 w-full md:w-auto md:flex-row md:justify-center animate-reveal delay-2">
      <a href="/commission/" class="btn-primary shadow-glow-gold hover:scale-[1.02] transition-transform group">
        <span>Check a date</span>
        <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
      </a>
      <a href="/#showreel" class="btn-secondary hover:scale-[1.02] transition-transform group">
        <svg class="size-4 fill-current mr-0.5 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24" aria-hidden="true">
          <polygon points="5 3 19 12 5 21 5 3" />
        </svg>
        <span>View showreel</span>
      </a>
    </div>

    {/* Cinema specs banner */}
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 border-t border-line/40 pt-6 text-eyebrow uppercase tracking-[0.2em] text-text-muted animate-reveal delay-3">
      <span class="flex items-center gap-2 hover:text-text-2 transition-colors duration-200">
        <span class="text-gold font-bold">&bull;</span> 4K DCI Cinema
      </span>
      <span class="hidden md:inline text-line/80">&bull;</span>
      <span class="flex items-center gap-2 hover:text-text-2 transition-colors duration-200">
        <span class="text-gold font-bold">&bull;</span> Multi-Cam & Drone
      </span>
      <span class="hidden md:inline text-line/80">&bull;</span>
      <span class="flex items-center gap-2 hover:text-text-2 transition-colors duration-200">
        <span class="text-gold font-bold">&bull;</span> Master Color Grade
      </span>
      <span class="hidden md:inline text-line/80">&bull;</span>
      <span class="flex items-center gap-2 hover:text-text-2 transition-colors duration-200">
        <span class="text-gold font-bold">&bull;</span> Raw Footage Archive
      </span>
    </div>
  </div>
</section>

<style>
  .sparkle-a,
  .sparkle-b,
  .sparkle-c {
    color: var(--gold);
    opacity: 0.55;
  }

  @media (min-width: 768px) {
    .sparkle-a {
      animation: twinkle 3.4s var(--motion-ease) infinite;
    }

    .sparkle-b {
      animation: twinkle 4s var(--motion-ease) 1.2s infinite;
    }

    .sparkle-c {
      animation: twinkle 3.4s var(--motion-ease) 2.3s infinite;
    }
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.95);
    }

    50% {
      opacity: 1;
      transform: scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sparkle-a,
    .sparkle-b,
    .sparkle-c {
      animation: none;
      opacity: 0.8;
    }
  }
</style>
