---
// FR-19: The five-step production rail from date reservation to master delivery.
const steps = [
  {
    number: "01",
    title: "Date & Brief Consultation",
    summary: "Check event date availability on WhatsApp with your location, schedule, and deliverable requirements. We confirm availability directly.",
  },
  {
    number: "02",
    title: "Creative Treatment & Logistics",
    summary: "We align on your visual style, emotional tone, music pacing, and itinerary. Technical reconnaissance ensures seamless execution on filming day.",
  },
  {
    number: "03",
    title: "Principal Cinematography",
    summary: "Dual-camera coverage with cinema prime lenses, professional wireless audio, and licensed drone aerial cinematography.",
  },
  {
    number: "04",
    title: "Color Grade & Sound Design",
    summary: "Meticulous scene assembly, dialogue mastering, custom cinematic color grading, and licensed music scoring.",
  },
  {
    number: "05",
    title: "Master 4K Delivery & Archive",
    summary: "Private digital 4K download link, quick social teasers within 10 days, and complete uncompressed raw footage archiving.",
  },
];
---

<section id="process" class="bg-surface-1 border-y border-line/60">
  <div class="container-site grid gap-8 py-18 md:py-30 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] lg:gap-16">
    <div class="flex flex-col gap-3" data-reveal>
      <p class="eyebrow">Production Workflow</p>
      <h2 class="font-display text-h2 text-text">From first consultation to final master</h2>
      <p class="text-body-large text-text-2 max-w-[45ch]">
        A structured, reliable process guarantees that your day runs without interruption and your films arrive on time.
      </p>
    </div>

    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step group" data-reveal data-reveal-delay={String(index + 1)}>
            <span class="step-number font-mono text-gold" aria-hidden="true">
              {step.number}
            </span>
            <div class="flex flex-col gap-2">
              <h3 class="font-display text-h3 text-text group-hover:text-gold transition-colors duration-200">
                {step.title}
              </h3>
              <p class="max-w-[60ch] text-body text-text-2 leading-relaxed">
                {step.summary}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Section 6: depth from borders, never from shadows, so the rows are divided rather than boxed. */
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    padding-block: 24px;
    border-top: 1px solid var(--line);
  }

  .step:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .step:last-child {
    padding-bottom: 0;
  }

  /* 44 px is the section 5 tap target, and it keeps the number legible at 13 px with tracking. */
  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 9999px;
    color: var(--gold);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    transition:
      transform var(--motion-base) var(--ease-out-back),
      border-color var(--motion-base) var(--motion-ease),
      background-color var(--motion-base) var(--motion-ease);
  }

  .step:hover .step-number {
    border-color: var(--gold);
    background-color: color-mix(in srgb, var(--gold) 10%, transparent);
    transform: scale(1.12);
  }
</style>
