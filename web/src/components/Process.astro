---
// FR-19. The five steps are a sequence, so the number carries meaning and leads each row. The copy
// is a builder draft under D25: no turnaround times, crew sizes or delivery promises.
const steps = [
  {
    number: "01",
    title: "Check the date",
    summary:
      "Send the date, the city and the kind of film you have in mind. You get a straight answer on availability and a starting point for the budget conversation.",
  },
  {
    number: "02",
    title: "Shape the brief",
    summary:
      "We agree how the day or the shoot should feel, what needs to be captured and what the finished pieces are for.",
  },
  {
    number: "03",
    title: "Shoot the day",
    summary:
      "One crew, one plan, and room for the moments nobody scheduled. You spend the day present; we spend it watching.",
  },
  {
    number: "04",
    title: "Cut, colour, sound",
    summary:
      "The edit finds the story. Colour and sound carry the mood. You see a cut and we refine it together.",
  },
  {
    number: "05",
    title: "Deliver and archive",
    summary:
      "The finished film arrives in the formats you asked for, with the raw material archived so nothing is lost.",
  },
];
---

<section id="process" class="section-rule bg-surface-1">
  <div class="container-site grid gap-12 py-20 md:py-32 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div class="flex flex-col gap-5 lg:sticky lg:top-32 lg:self-start" data-reveal>
      <p class="eyebrow">The process</p>
      <h2 class="max-w-[14ch] text-h2 font-semibold text-text">
        From first message to <span class="display-italic text-gold">final cut.</span>
      </h2>
      <p class="max-w-[40ch] text-body text-text-2">
        Five steps, no mystery. You always know what happens next and who is doing it.
      </p>
      <a href="/commission/" class="btn-secondary mt-2 w-fit">
        Start with a date
        <svg class="size-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>

    <ol class="flex flex-col">
      {
        steps.map((step, index) => (
          <li
            class="group grid grid-cols-[auto_1fr] gap-5 border-t border-line py-7 last:border-b md:gap-8 md:py-9"
            data-reveal
            data-reveal-delay={String(Math.min(index + 1, 5))}
          >
            <span
              class="flex size-11 items-center justify-center rounded-full border border-line font-mono text-small text-gold transition-colors duration-300 group-hover:border-gold"
              aria-hidden="true"
            >
              {step.number}
            </span>
            <div class="flex flex-col gap-2.5">
              <h3 class="text-h3 font-semibold text-text transition-colors duration-300 group-hover:text-gold">
                {step.title}
              </h3>
              <p class="max-w-[58ch] text-body text-text-2">{step.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
