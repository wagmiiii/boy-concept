---
// FR-19. Answers are builder drafts under D25 and make no promise about turnaround, price or kit.
const faqs = [
  {
    q: "How far ahead should we book?",
    a: "As early as you can. Dates are confirmed one at a time, so a brief with a fixed date is easier to answer than a maybe.",
  },
  {
    q: "Do you travel?",
    a: "Yes. Travel and accommodation are part of the brief and are agreed before anything is confirmed.",
  },
  {
    q: "What do we actually receive?",
    a: "Every brief is quoted with its own deliverables: the length, the formats and the number of finished pieces. Nothing is assumed.",
  },
  {
    q: "How does the WhatsApp handoff work?",
    a: "The brief builder turns your answers into one message. You press the button and send it yourself on WhatsApp, so you keep your own copy of exactly what was said.",
  },
  {
    q: "Can we see the raw footage?",
    a: "Ask for it in the brief. We will tell you what is possible for that shoot and how it would be delivered.",
  },
];
---

<section id="faq" class="container-site py-20 md:py-32">
  <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div class="flex flex-col gap-4 lg:sticky lg:top-32 lg:self-start" data-reveal>
      <p class="eyebrow">Questions</p>
      <h2 class="max-w-[12ch] text-h2 font-semibold text-text">
        Before you <span class="display-italic text-gold">ask.</span>
      </h2>
      <p class="max-w-[34ch] text-small text-text-muted">
        Anything else, message us directly. A person answers.
      </p>
    </div>

    <div class="flex flex-col">
      {
        faqs.map((faq, index) => (
          <details
            class="group border-t border-line last:border-b"
            data-reveal
            data-reveal-delay={String(Math.min(index + 1, 5))}
          >
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
              <span class="text-h3 font-medium text-text transition-colors duration-300 group-hover:text-gold">
                {faq.q}
              </span>
              <span class="relative flex size-9 shrink-0 items-center justify-center rounded-full border border-line text-gold transition-colors duration-300 group-open:border-gold group-hover:border-gold">
                <span class="absolute h-px w-3 bg-current"></span>
                <span class="absolute h-3 w-px bg-current transition-transform duration-300 group-open:rotate-90 group-open:scale-0"></span>
              </span>
            </summary>
            <p class="max-w-[62ch] pb-7 text-body text-text-2">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
