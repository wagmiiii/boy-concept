---
// The reel. One item on stage at a time, chosen from the rail under it. Only the first item starts
// by itself: muted, looping, silent, and only while the stage is at least half on screen (D29).
// Every other item waits for a tap, so the page never spends a visitor's data on its own.
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { reelItems, sampleFootageLabel } from "../content-rules";
import { isSelfHostedVideo } from "../media-sources";
import { posterFor } from "../poster-index";

const reels = reelItems(await getCollection("projects"));
const autoplayIndex = reels.length > 0 && isSelfHostedVideo(reels[0]!.data.video_url) ? 0 : null;
---

{
  reels.length > 0 ? (
    <section id="reel" class="relative overflow-hidden py-20 md:py-32" data-reel>
      <div class="ambient-gold pointer-events-none absolute inset-x-0 top-0 h-[420px]" aria-hidden="true" />

      <div class="container-site relative">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
          <div class="flex flex-col gap-4">
            <p class="eyebrow">The reel</p>
            <h2 class="max-w-[18ch] text-h2 font-semibold text-text">
              See the work in <span class="display-italic text-gold">motion.</span>
            </h2>
          </div>
          <p class="max-w-[34ch] text-small text-text-muted md:text-right">
            Five cuts from recent shoots. The first plays quietly on its own; everything else waits
            for you.
          </p>
        </div>

        <div class="relative mx-auto mt-10 w-full max-w-[400px] md:mt-14" data-reveal data-reveal-delay="1">
          <div class="stage-frame border border-line-strong bg-surface-1 shadow-[0_50px_120px_-40px_var(--bg)]">
            {
              reels.map((reel, index) => {
                const poster = posterFor(reel.data.poster ?? "");
                const selfHosted = isSelfHostedVideo(reel.data.video_url);

                return (
                  <div
                    class="absolute inset-0"
                    data-reel-frame
                    data-index={index}
                    data-src={reel.data.video_url}
                    data-kind={selfHosted ? "file" : "youtube"}
                    data-autoplay={index === autoplayIndex ? "true" : undefined}
                    hidden={index === 0 ? undefined : true}
                  >
                    {poster ? (
                      <Image
                        src={poster}
                        widths={[400, 720, 1080]}
                        sizes="(max-width: 767px) 92vw, 400px"
                        alt={reel.data.demo ? `${reel.data.title} still. ${sampleFootageLabel}.` : `${reel.data.title} still`}
                        class="absolute inset-0 size-full object-cover"
                      />
                    ) : null}

                    <div class="media-chrome absolute inset-0 flex flex-col justify-between p-4 md:p-8" data-reel-caption>
                      <div class="flex items-start justify-between gap-4">
                        <span class="tag">{reel.data.category}</span>
                        {reel.data.demo ? <span class="tag">{sampleFootageLabel}</span> : null}
                      </div>

                      <div class="flex items-end justify-between gap-4">
                        <div class="flex min-w-0 flex-col gap-1">
                          <p class="truncate text-h4 font-medium text-media-text">{reel.data.title}</p>
                          <p class="text-eyebrow uppercase tracking-[0.2em] text-media-text/60">
                            {String(index + 1).padStart(2, "0")} / {String(reels.length).padStart(2, "0")}
                          </p>
                        </div>

                        <button
                          type="button"
                          class="group/play pointer-events-auto flex size-14 shrink-0 items-center justify-center rounded-full border border-media-text/40 bg-bg/40 text-media-text backdrop-blur-md transition-all duration-300 hover:scale-105 hover:border-gold hover:bg-bg/70 hover:text-gold"
                          data-reel-play
                        >
                          <span class="sr-only">Play {reel.data.title}</span>
                          <svg class="ml-1 size-5 fill-current md:size-6" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M8 5.5v13l11-6.5z" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                );
              })
            }
          </div>

          <div class="mt-4 flex items-center justify-between gap-4">
            <div class="flex items-center gap-2">
              <button type="button" class="btn-icon" data-reel-prev>
                <span class="sr-only">Previous clip</span>
                <svg class="size-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M19 12H5M11 6l-6 6 6 6" />
                </svg>
              </button>
              <button type="button" class="btn-icon" data-reel-next>
                <span class="sr-only">Next clip</span>
                <svg class="size-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </button>
              <button type="button" class="btn-icon hidden" data-reel-pause>
                <span class="sr-only" data-reel-pause-label>Pause the reel</span>
                <svg class="pause-icon size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8.5 5h3v14h-3zM13 5h3v14h-3z" />
                </svg>
                <svg class="play-icon size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8 5.5v13l11-6.5z" />
                </svg>
              </button>
            </div>

            <p class="text-small text-text-muted">
              <span data-reel-counter>01</span> / {String(reels.length).padStart(2, "0")}
            </p>
          </div>
        </div>

        <ol class="mt-8 flex justify-start gap-3 overflow-x-auto pb-2 md:justify-center lg:gap-4" aria-label="Choose a reel clip">
          {
            reels.map((reel, index) => {
              const poster = posterFor(reel.data.poster ?? "");
              return (
                <li class="w-[112px] shrink-0 md:w-[132px]">
                  <button
                    type="button"
                    class="group block w-full text-left"
                    data-reel-select={index}
                    aria-current={index === 0 ? "true" : undefined}
                  >
                    <span class="tile-frame block aspect-[9/16] border border-line transition-all duration-300 group-hover:border-gold/60 group-hover:-translate-y-1">
                      {poster ? (
                        <Image
                          src={poster}
                          widths={[132, 264]}
                          sizes="(max-width: 767px) 112px, 132px"
                          alt=""
                          class="absolute inset-0 size-full object-cover opacity-80 transition-opacity duration-300 group-hover:opacity-100"
                        />
                      ) : null}
                    </span>
                    <span class="mt-2 flex items-baseline justify-between gap-2">
                      <span class="truncate text-small text-text-2 transition-colors group-hover:text-text">{reel.data.title}</span>
                      <span class="text-[0.65rem] font-medium tracking-[0.2em] text-text-muted">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                    </span>
                  </button>
                </li>
              );
            })
          }
        </ol>
      </div>
    </section>
  ) : null
}

<script>
  import { youtubeEmbedUrl } from "../media-sources";

  const stage = document.querySelector<HTMLElement>("[data-reel]");

  if (stage) {
    const frames = [...stage.querySelectorAll<HTMLElement>("[data-reel-frame]")];
    const strip = [...stage.querySelectorAll<HTMLButtonElement>("[data-reel-select]")];
    const counter = stage.querySelector<HTMLElement>("[data-reel-counter]");
    const pauseButton = stage.querySelector<HTMLButtonElement>("[data-reel-pause]");
    const pauseLabel = pauseButton?.querySelector<HTMLElement>("[data-reel-pause-label]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let active = 0;

    const videoIn = (frame: HTMLElement) => frame.querySelector("video");

    const stop = (frame: HTMLElement) => {
      frame.querySelectorAll("video, iframe").forEach((media) => media.remove());
      delete frame.dataset.playing;
      delete frame.dataset.paused;
      delete frame.dataset.autopaused;
      delete frame.dataset.userOwned;
    };

    const setPaused = (frame: HTMLElement, paused: boolean) => {
      const video = videoIn(frame);
      if (!video) return;
      if (paused) video.pause();
      else void video.play().catch(() => undefined);
      frame.dataset.paused = String(paused);
      if (pauseLabel) pauseLabel.textContent = paused ? "Play the reel" : "Pause the reel";
    };

    const start = (frame: HTMLElement, muted: boolean) => {
      const src = frame.dataset.src ?? "";
      let media: HTMLElement;

      if (frame.dataset.kind === "youtube") {
        const embed = youtubeEmbedUrl(src);
        if (!embed) return;
        const iframe = document.createElement("iframe");
        iframe.src = embed;
        iframe.allow = "autoplay; encrypted-media; picture-in-picture";
        iframe.allowFullscreen = true;
        iframe.title = "Reel clip";
        iframe.className = "absolute inset-0 z-0 size-full";
        media = iframe;
      } else {
        const video = document.createElement("video");
        video.src = src;
        video.muted = muted;
        video.defaultMuted = muted;
        video.playsInline = true;
        video.controls = !muted;
        video.loop = muted;
        video.className = "absolute inset-0 z-0 size-full bg-surface-cinema object-cover";
        media = video;
      }

      frame.dataset.playing = "true";
      frame.append(media);

      if (media instanceof HTMLVideoElement) {
        if (muted) {
          media.addEventListener("click", () => {
            if (frame.dataset.userOwned === "true") return;
            setPaused(frame, frame.dataset.paused !== "true");
          });
          media
            .play()
            .then(() => {
              frame.dataset.paused = "false";
            })
            .catch(() => setPaused(frame, true));
        } else {
          void media.play().catch(() => undefined);
        }
      }
    };

    const syncControls = () => {
      const frame = frames[active];
      if (!frame) return;
      if (counter) counter.textContent = String(active + 1).padStart(2, "0");
      const playing = frame.dataset.playing === "true" && frame.dataset.paused !== "true";
      pauseButton?.classList.toggle("hidden", frame.dataset.playing !== "true");
      pauseButton?.classList.toggle("flex", frame.dataset.playing === "true");
      if (pauseLabel && pauseButton) {
        pauseLabel.textContent = playing ? "Pause the reel" : "Play the reel";
      }
    };

    const activate = (index: number) => {
      active = (index + frames.length) % frames.length;
      frames.forEach((frame, frameIndex) => {
        const selected = frameIndex === active;
        frame.toggleAttribute("hidden", !selected);
        if (!selected) stop(frame);
      });
      strip.forEach((button, buttonIndex) => {
        if (buttonIndex === active) button.setAttribute("aria-current", "true");
        else button.removeAttribute("aria-current");
      });
      syncControls();
    };

    strip.forEach((button) => {
      button.addEventListener("click", () => {
        const index = Number(button.dataset.reelSelect);
        if (Number.isInteger(index)) activate(index);
      });
    });

    stage.querySelector<HTMLButtonElement>("[data-reel-prev]")?.addEventListener("click", () => activate(active - 1));
    stage.querySelector<HTMLButtonElement>("[data-reel-next]")?.addEventListener("click", () => activate(active + 1));

    frames.forEach((frame) => {
      frame.querySelector<HTMLButtonElement>("[data-reel-play]")?.addEventListener("click", () => {
        start(frame, false);
        frame.dataset.userOwned = "true";
        syncControls();
      });
    });

    pauseButton?.addEventListener("click", () => {
      const frame = frames[active];
      if (!frame) return;
      if (frame.dataset.playing === "true") setPaused(frame, frame.dataset.paused !== "true");
      else start(frame, true);
      syncControls();
    });

    const autoplayFrame = frames.find((frame) => frame.dataset.autoplay === "true");

    if (autoplayFrame && !reducedMotion) {
      let inView = false;
      let pageLoaded = document.readyState === "complete";

      const maybeStart = () => {
        if (!inView || !pageLoaded || active !== 0) return;
        if (!autoplayFrame.dataset.playing) start(autoplayFrame, true);
        else if (autoplayFrame.dataset.autopaused === "true") {
          delete autoplayFrame.dataset.autopaused;
          setPaused(autoplayFrame, false);
        }
        syncControls();
      };

      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            inView = entry.isIntersecting;
            const playing = autoplayFrame.dataset.playing === "true";
            const banner = autoplayFrame.dataset.userOwned !== "true";
            if (!inView && banner && playing && autoplayFrame.dataset.paused !== "true") {
              setPaused(autoplayFrame, true);
              autoplayFrame.dataset.autopaused = "true";
            }
          }
          maybeStart();
        },
        { threshold: 0.5 },
      ).observe(autoplayFrame);

      window.addEventListener("load", () => {
        pageLoaded = true;
        maybeStart();
      });
    }

    syncControls();
  }
</script>

<style>
  [data-playing="true"] [data-reel-play] {
    display: none;
  }

  [data-playing="true"] [data-reel-caption] {
    display: none;
  }

  .play-icon,
  [data-paused="true"] .pause-icon {
    display: none;
  }

  [data-paused="true"] .play-icon {
    display: block;
  }

  [data-reel-select][aria-current="true"] > .tile-frame {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
</style>
