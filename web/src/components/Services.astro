---
// FR-19. Four offers, matching the four categories the work is filed under. The copy is a builder
// draft under D25 and promises no equipment, turnaround or price the client has not confirmed.
const services = [
  {
    number: "01",
    name: "Weddings and celebrations",
    description:
      "Traditional and white weddings, engagements and receptions. We follow the day as it happens and cut it into a film you will want to watch again.",
    tags: ["Highlight film", "Full ceremony", "Teaser cut"],
  },
  {
    number: "02",
    name: "Commercial and brand",
    description:
      "Campaign films, product stories and fashion pieces. One clear idea, shot with intent and finished for the places people actually watch.",
    tags: ["Brand film", "Social cuts", "Product"],
  },
  {
    number: "03",
    name: "Cultural events and galas",
    description:
      "Festivals, ceremonies and live gatherings. The crowd, the colour and the sound, documented with a cinema eye and a documentarian's patience.",
    tags: ["Event coverage", "Multi-cam", "Highlights"],
  },
  {
    number: "04",
    name: "Documentary and portraits",
    description:
      "Long-form profiles, retrospectives and interviews. Quiet, patient storytelling for people and institutions with something worth recording.",
    tags: ["Interviews", "Long form", "Archive"],
  },
];
---

<section id="services" class="container-site py-20 md:py-32">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
    <div class="flex flex-col gap-4">
      <p class="eyebrow">What we shoot</p>
      <h2 class="max-w-[18ch] text-h2 font-semibold text-text">
        One crew, four <span class="display-italic text-gold">instincts.</span>
      </h2>
    </div>
    <p class="max-w-[34ch] text-small text-text-muted md:text-right">
      Every commission starts with the date and the story. The format follows.
    </p>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-4 md:mt-14 md:grid-cols-2">
    {
      services.map((service, index) => (
        <article
          class="group panel relative flex flex-col justify-between gap-8 overflow-hidden p-6 transition-colors duration-500 hover:border-gold/50 md:p-8"
          data-reveal
          data-reveal-delay={String((index % 2) + 1)}
        >
          <div class="pointer-events-none absolute -right-10 -top-10 size-40 rounded-full border border-line/60 transition-transform duration-700 group-hover:scale-110" aria-hidden="true" />

          <div class="relative flex flex-col gap-4">
            <div class="flex items-start justify-between">
              <span class="font-mono text-small tracking-[0.2em] text-gold">{service.number}</span>
              <span class="size-1.5 rounded-full bg-line-strong transition-colors duration-300 group-hover:bg-gold" aria-hidden="true"></span>
            </div>
            <h3 class="max-w-[18ch] text-h3 font-semibold text-text">{service.name}</h3>
            <p class="max-w-[46ch] text-body text-text-2">{service.description}</p>
          </div>

          <div class="relative flex flex-col gap-5">
            <ul class="flex flex-wrap gap-2">
              {service.tags.map((tag) => (
                <li class="rounded-full border border-line px-3 py-1.5 text-small text-text-muted">
                  {tag}
                </li>
              ))}
            </ul>
            <a href="/commission/" class="inline-flex min-h-11 w-fit items-center gap-2 text-small font-semibold text-text transition-colors hover:text-gold">
              Start a brief
              <svg class="size-3.5 fill-none stroke-current transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
