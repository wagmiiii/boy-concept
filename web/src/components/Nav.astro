---
// Floating navigation. The brand is text: the 3D logo is 1600 x 760 and cannot meet its own 220 px
// minimum inside a 64 px bar (DESIGN section 2 rule 4), so the compact star mark carries the page.
const links = [
  { href: "/#work", label: "Work" },
  { href: "/#reel", label: "Reel" },
  { href: "/#services", label: "Services" },
  { href: "/#process", label: "Process" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 pt-4 md:pt-6">
  <div class="container-site pointer-events-auto">
    <div
      class="glass relative flex h-16 items-center justify-between gap-3 rounded-full px-3 shadow-[0_18px_50px_-20px_var(--bg)] md:h-[72px] md:px-5"
    >
      <a
        href="/"
        class="group inline-flex min-h-11 items-center gap-2.5 rounded-full pl-1 pr-2 text-text transition-colors hover:text-gold"
      >
        <span
          class="flex size-8 items-center justify-center rounded-full border border-gold/40 bg-surface-2 text-gold transition-transform duration-500 group-hover:rotate-90"
        >
          <svg class="size-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0L14.8 9.2L24 12L14.8 14.8L12 24L9.2 14.8L0 12L9.2 9.2L12 0Z" />
          </svg>
        </span>
        <span class="text-[1.05rem] font-semibold tracking-tight">Boy Concept<span class="text-gold">.</span></span>
      </a>

      <nav class="absolute left-1/2 hidden -translate-x-1/2 md:block" aria-label="Main">
        <ul class="flex items-center gap-1">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-11 items-center rounded-full px-3.5 text-small font-medium text-text-2 transition-colors duration-200 hover:bg-surface-3/70 hover:text-text"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="theme-toggle"
          class="inline-flex size-11 items-center justify-center rounded-full border border-line-strong text-text-2 transition-colors duration-200 hover:border-gold hover:text-gold"
          aria-label="Switch between light and dark theme"
          title="Switch theme"
        >
          <svg class="hidden size-[18px] fill-none stroke-current [html:not([data-theme='light'])_&]:block" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4" />
          </svg>
          <svg class="hidden size-[18px] fill-none stroke-current [html[data-theme='light']_&]:block" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
          </svg>
        </button>

        <a href="/commission/" class="btn-primary hidden text-small md:inline-flex">
          Start a brief
          <svg class="size-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>

        <button
          type="button"
          id="menu-toggle"
          class="inline-flex size-11 items-center justify-center rounded-full border border-line-strong text-text md:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="size-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M4 8h16M4 16h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="pointer-events-auto fixed inset-0 z-40 hidden bg-bg/95 backdrop-blur-2xl md:hidden"
    data-menu
  >
    <div class="container-site flex h-full flex-col justify-between pb-10 pt-28">
      <nav aria-label="Mobile">
        <ul class="flex flex-col">
          {
            links.map((link, index) => (
              <li>
                <a
                  href={link.href}
                  class="group flex items-baseline justify-between border-b border-line py-5 text-[2rem] font-semibold tracking-tight text-text transition-colors hover:text-gold"
                >
                  <span>{link.label}</span>
                  <span class="text-eyebrow font-medium tracking-[0.2em] text-text-muted">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-3 pt-8">
        <a href="/commission/" class="btn-primary w-full">
          Start a brief
          <svg class="size-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <p class="text-small text-text-muted">Lagos, Nigeria. Shooting worldwide.</p>
      </div>
    </div>
  </div>
</header>

<script>
  const themeButton = document.getElementById("theme-toggle");
  themeButton?.addEventListener("click", () => {
    const isLight = document.documentElement.getAttribute("data-theme") === "light";
    const next = isLight ? "dark" : "light";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
  });

  const menuButton = document.getElementById("menu-toggle");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  const setMenu = (open: boolean) => {
    if (!menu || !menuButton) return;
    menu.classList.toggle("hidden", !open);
    menuButton.setAttribute("aria-expanded", String(open));
    menuButton.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.body.style.overflow = open ? "hidden" : "";
  };

  menuButton?.addEventListener("click", () => {
    setMenu(menuButton.getAttribute("aria-expanded") !== "true");
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });
</script>
