---
// DESIGN.md section 7 Navigation. The brand is text, not the 3D logo: the logo is 1600 x 760,
// so at the 64 px nav height it is 135 px wide, under the 220 px minimum in DESIGN.md section 2
// rule 4. That rule and the nav height cannot both hold until the flat wordmark exists (P-21).
const links = [
  { href: "#showreel", label: "Showreel" },
  { href: "#work", label: "Portfolio" },
  { href: "#services", label: "Services" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/60 backdrop-blur-[12px]">
  <nav
    class="mx-auto flex h-16 max-w-site items-center gap-4 px-5 md:h-18 md:px-8"
    aria-label="Main"
  >
    <a href="/" class="font-display text-h3 text-text">Boy Concept</a>

    <ul class="mx-auto hidden items-center gap-6 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-small font-semibold text-text-2 transition-colors hover:text-gold"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <details class="relative md:hidden">
        <summary
          class="flex min-h-11 cursor-pointer list-none items-center rounded-button px-3 text-small font-semibold text-text-2 [&::-webkit-details-marker]:hidden hover:text-gold"
        >
          Menu
        </summary>
        <ul
          class="absolute right-0 top-full z-50 mt-1 flex w-44 flex-col gap-1 rounded-card border border-line bg-surface-2 p-3"
        >
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="flex min-h-11 items-center text-small font-semibold text-text-2 hover:text-gold"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <a href="#enquiry" class="btn-primary">Check a date</a>
    </div>
  </nav>
</header>

<style>
  /* DESIGN.md section 7: solid black where the blur is unsupported. */
  @supports not (backdrop-filter: blur(12px)) {
    header {
      background-color: var(--bg);
    }
  }
</style>
