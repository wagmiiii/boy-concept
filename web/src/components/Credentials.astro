---
// FR-6, FR-7 and FR-26. Credentials render only when they are verified, and the section keeps its
// shape in Phase 0 with entries explicitly marked demo. A demo entry prints a neutral state, never
// the bracketed text it holds, so no unverified claim reaches a visitor (D23).
import { getCollection } from "astro:content";
import { visibleCredentials } from "../content-rules";

const cards = visibleCredentials(await getCollection("credentials"));
---

{
  cards.length > 0 ? (
    <section id="credentials" class="section-rule">
      <div class="container-site py-16 md:py-24">
        <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between" data-reveal>
          <div class="flex flex-col gap-4">
            <p class="eyebrow">On paper</p>
            <h2 class="max-w-[20ch] text-h2 font-semibold text-text">
              The boring parts, <span class="display-italic text-gold">done properly.</span>
            </h2>
          </div>
          <p class="max-w-[34ch] text-small text-text-muted md:text-right">
            Registration and equipment details are published only once they have been checked.
          </p>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:mt-14">
          {cards.map((card, index) => (
            <article
              class="flex flex-col justify-between gap-8 rounded-card border border-line bg-surface-1 p-6 transition-colors duration-300 hover:border-line-strong md:p-8"
              data-reveal
              data-reveal-delay={String(index + 1)}
            >
              <div class="flex items-start justify-between gap-4">
                <p class="eyebrow eyebrow-plain text-text-muted">{card.data.type}</p>
                {card.data.demo ? (
                  <span class="rounded-full border border-line px-3 py-1 text-[0.65rem] uppercase tracking-[0.18em] text-text-muted">
                    Sample
                  </span>
                ) : null}
              </div>

              <div class="flex flex-col gap-2">
                <p class="text-h3 font-medium text-text">
                  {card.data.verified ? card.data.value : "Awaiting verification"}
                </p>
                <p class="text-small text-text-muted">
                  {card.data.verified && card.data.source
                    ? `Source: ${card.data.source}`
                    : "The verified detail appears here once it has been checked and cleared for publication."}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ) : null
}
