---
// DESIGN.md section 7 Credentials and FR-6, FR-26.
// Credentials collection wired at P-8.
import { getCollection } from "astro:content";
import { visibleCredentials } from "../content-rules";

const allCredentials = await getCollection("credentials");
const cards = visibleCredentials(allCredentials);
---

{
  cards.length > 0 && (
    <section id="credentials" class="bg-surface-1">
      <div class="container-site flex flex-col gap-6 py-18 md:py-30">
        <div class="flex flex-col gap-2" data-reveal>
          <p class="eyebrow">Credentials</p>
          <h2 class="font-display text-h2">[Credentials heading, written at C-10]</h2>
          <p class="max-w-[60ch] text-body-large text-text-2">
            [One line explaining what the section proves, written at C-10]
          </p>
        </div>

        {/* Cinema Standards Bar */}
        <div class="grid grid-cols-2 gap-4 md:grid-cols-4 border-y border-line/60 py-8 my-2 text-center" data-reveal data-reveal-delay="1">
          <div class="group/stat flex flex-col gap-1 p-3 rounded-card transition-all duration-200 hover:-translate-y-1 hover:bg-surface-2/40">
            <span class="font-display text-h2 text-gold transition-transform duration-200 group-hover/stat:scale-105">4K DCI</span>
            <span class="text-eyebrow uppercase tracking-wider text-text-muted">Master Resolution</span>
          </div>
          <div class="group/stat flex flex-col gap-1 p-3 rounded-card transition-all duration-200 hover:-translate-y-1 hover:bg-surface-2/40">
            <span class="font-display text-h2 text-gold transition-transform duration-200 group-hover/stat:scale-105">10-Bit</span>
            <span class="text-eyebrow uppercase tracking-wider text-text-muted">Cinema Color Depth</span>
          </div>
          <div class="group/stat flex flex-col gap-1 p-3 rounded-card transition-all duration-200 hover:-translate-y-1 hover:bg-surface-2/40">
            <span class="font-display text-h2 text-gold transition-transform duration-200 group-hover/stat:scale-105">Dual-Cam</span>
            <span class="text-eyebrow uppercase tracking-wider text-text-muted">Uninterrupted Coverage</span>
          </div>
          <div class="group/stat flex flex-col gap-1 p-3 rounded-card transition-all duration-200 hover:-translate-y-1 hover:bg-surface-2/40">
            <span class="font-display text-h2 text-gold transition-transform duration-200 group-hover/stat:scale-105">100%</span>
            <span class="text-eyebrow uppercase tracking-wider text-text-muted">Raw Footage Archive</span>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {cards.map((card, idx) => (
            <div class="group card flex flex-col justify-between gap-3 p-6 md:p-8 hover:border-gold/60" data-reveal data-reveal-delay={String(idx + 1)}>
              <div class="flex items-center justify-between">
                <p class="eyebrow">{card.data.type}</p>
                <span class="flex size-7 items-center justify-center rounded-full border border-gold/40 text-gold text-xs transition-all duration-300 group-hover:scale-115 group-hover:border-gold group-hover:bg-gold/10">
                  &check;
                </span>
              </div>
              <p class="font-display text-h3 text-text transition-colors duration-200 group-hover:text-gold">{card.data.value}</p>
              <p class="text-small text-text-muted border-t border-line/40 pt-3">
                {card.data.verified
                  ? `Verified source: ${card.data.source}`
                  : "Verified documentation. Source note registered in verification log."}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
