---
// DESIGN.md section 7 Credentials and FR-6: only items with a verified flag render, and FR-26
// hides the whole section below the agreed minimum. Nothing is verified yet, so every card here
// is a neutral DEMO block with no registration number, no client name and no stat.
const demoCards = [
  { type: "DEMO", value: "[verified credential, from content/verification-log.md]" },
  { type: "DEMO", value: "[verified credential, from content/verification-log.md]" },
];
---

<section id="credentials" class="bg-surface-1">
  <div class="mx-auto flex max-w-site flex-col gap-6 px-5 py-18 md:px-8 md:py-30">
    <div class="flex flex-col gap-2">
      <p class="eyebrow">Credentials</p>
      <h2 class="font-display text-h2">[Credentials heading, written at C-10]</h2>
      <p class="max-w-[60ch] text-body-large text-text-2">
        [One line explaining what the section proves, written at C-10]
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        demoCards.map((card) => (
          <div class="card flex flex-col gap-2 p-6">
            <p class="eyebrow">{card.type}</p>
            <p class="text-body text-text">{card.value}</p>
            <p class="text-small text-text-muted">
              Verified items only. Source note lives in content/verification-log.md.
            </p>
          </div>
        ))
      }
    </div>

    <p class="text-small text-text-muted">
      This section hides entirely while it holds fewer than [N] verified items (FR-26, P-8).
    </p>
  </div>
</section>
