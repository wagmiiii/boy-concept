---
import Font from "astro/components/Font.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** The test environment stays out of search engines until P-20 decides otherwise. */
  noindex?: boolean;
}

const { title, description = "", noindex = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <Font cssVariable="--font-marcellus" preload />
    <Font cssVariable="--font-inter" preload />
    <title>{title}</title>
  </head>
  <body class="bg-bg text-text font-sans">
    <slot />
  </body>
</html>
